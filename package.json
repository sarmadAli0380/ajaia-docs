{
  "name": "ajaia-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight collaborative document editor (Express + React + TipTap + Postgres/PGlite)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \"client/**\" --ignore \"dist/**\" --ignore \"**/*.timestamp-*.mjs\" server/dev.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.build.json",
    "start": "node dist/node/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "sanitize-html": "2.17.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/html": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
